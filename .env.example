# Copy to .env.local. Never commit credentials. Public key is scoped by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact allowed origin for auth redirects (no trailing slash).
# REQUIRED in Vercel Preview and Production (https://...): the app refuses to
# send invitation/recovery links to localhost when VERCEL_ENV is set.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional, SERVER ONLY: enables Auth invitation emails. Never use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED to verify receipts, SERVER ONLY (never NEXT_PUBLIC_): at least 32
# random characters, e.g. `openssl rand -hex 32`. The SAME value must be stored
# in Supabase Vault as 'cuadria_receipt_verification' (docs/OPERATIONS.md §13).
# Without it, uploaded receipts stay pending and are never marked verified.
RECEIPT_VERIFICATION_SECRET=

# Optional Cloudflare Turnstile (CAPTCHA) for login, recovery and password
# change. Leave empty to disable. When set, CAPTCHA protection must also be
# enabled in Supabase Auth with the matching secret key (configured in the
# Supabase dashboard, never in this app).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Only for the local Supabase CLI ([auth.captcha] in supabase/config.toml).
# SUPABASE_AUTH_CAPTCHA_SECRET=

# Set automatically by Vercel; used as Next.js deploymentId (Skew Protection).
# VERCEL_DEPLOYMENT_ID=
