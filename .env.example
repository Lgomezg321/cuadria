# Copy to .env.local. Never commit credentials. Public key is scoped by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact allowed origin for auth redirects (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional, SERVER ONLY: enables Auth invitation emails. Never use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
